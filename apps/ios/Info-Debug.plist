<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- iPhones with ProMotion hold app rendering at 60 Hz unless the app asks; the stream is 120 fps
	     on those panels, so ask. iPads ignore this key. -->
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<!-- Export compliance: DuoDeck uses no encryption but Apple's own, so uploads, TestFlight builds
	     included, skip the encryption questions. Look again before adding cipher code or a crypto
	     library of DuoDeck's own (docs/app-store-metadata.md section 6). -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Finds your Mac on the local network.</string>
	<!-- DEBUG ONLY: Info.plist (the Release configuration's) plus `_duodecktest._tcp`, which the Debug
	     build browses for with -DuoDeckServiceType _duodecktest._tcp: the simulator refuses a browse for
	     a type this list does not declare (-65555 NoAuth, docs/home-pairing-plan.md, H0's P5). A
	     key added to Info.plist goes here too; nothing else may differ. -->
	<key>NSBonjourServices</key>
	<array>
		<string>_duodeck._tcp</string>
		<string>_duodecktest._tcp</string>
	</array>
	<!-- Add a Mac: the embedded scanner reads the pairing code the Mac shows. -->
	<key>NSCameraUsageDescription</key>
	<string>DuoDeck scans the pairing code shown by DuoDeck Host on your Mac. On iPhone Duo it also keeps the back screen on while it mirrors your Mac or works as a trackpad. Nothing is recorded or saved.</string>
	<!-- duodeck://pair links from the Camera or Messages. Never acted on without a confirmation, since
	     another app could claim the scheme too; the in-app scanner is the main path. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.agentsai.duodeck.pair</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>duodeck</string>
				</array>
		</dict>
	</array>
</dict>
</plist>
